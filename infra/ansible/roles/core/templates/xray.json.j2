{
  "log": { "loglevel": "warning" },
  "api": { "tag": "api", "services": ["HandlerService", "StatsService"] },
  "stats": {},
  "policy": {
    "levels": { "0": { "statsUserUplink": true, "statsUserDownlink": true } },
    "system": { "statsInboundUplink": true, "statsInboundDownlink": true }
  },
  "inbounds": [
    {
      "tag": "api",
      "listen": "127.0.0.1",
      "port": {{ xray_api_port }},
      "protocol": "dokodemo-door",
      "settings": { "address": "127.0.0.1" }
    },
    {
      "tag": "reality",
      "listen": "0.0.0.0",
      "port": {{ xray_reality_port }},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "{{ vault_vless_id }}", "flow": "xtls-rprx-vision" } ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "{{ xray_reality_dest }}",
          "serverNames": [ "{{ xray_reality_sni }}" ],
          "privateKey": "{{ vault_reality_private_key }}",
          "shortIds": [ "{{ vault_reality_short_id }}" ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnlySelectedDomains": false,
        "domains": {{ xray_sniff_domains | to_json }}
      }
    },
    {
      "tag": "kcp",
      "listen": "0.0.0.0",
      "port": {{ xray_kcp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "{{ vault_vless_id }}" } ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "kcp",
        "kcpSettings": {
          "mtu": {{ xray_kcp_mtu }},
          "tti": 20,
          "uplinkCapacity": 100,
          "downlinkCapacity": 100,
          "congestion": false,
          "readBufferSize": 2,
          "writeBufferSize": 2,
          "header": { "type": "srtp" },
          "seed": "{{ vault_kcp_seed }}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnlySelectedDomains": false,
        "domains": {{ xray_sniff_domains | to_json }}
      }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
{% if xray_hop_server is defined and xray_hop_server %}
    {
      "tag": "hop",
      "protocol": "{{ xray_hop_protocol | default('socks') }}",
      "settings": {
        "servers": [
          {
            "address": "{{ xray_hop_server }}",
            "port": {{ xray_hop_port | default(1080) }}
{% if vault_xray_hop_user is defined and vault_xray_hop_user %}
            ,
            "users": [
              {
                "user": "{{ vault_xray_hop_user }}",
                "pass": "{{ vault_xray_hop_pass }}"
              }
            ]
{% endif %}
          }
        ]
      }
    },
{% endif %}
    { "tag": "block", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      { "type": "field", "inboundTag": ["api"], "outboundTag": "api" },
{% if xray_hop_server is defined and xray_hop_server %}
      {
        "type": "field",
        "domain": {{ xray_sniff_domains | to_json }},
        "outboundTag": "hop"
      },
{% endif %}
      { "type": "field", "outboundTag": "direct" }
    ]
  }
}